# ─── Rabnix Estate — environment ───
# Copy to .env and fill in. NEVER commit .env.

# Postgres. Simplest setup: a free managed DB (Neon or Supabase) — no local install.
# Create one, then paste its connection string here. PostGIS is only needed for later geo
# features (bbox/radius search); the current app runs fine on plain Postgres.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Auth
JWT_SECRET="change-me-in-production"
OTP_TTL_SECONDS="300"

# Cron — shared secret for scheduled jobs (e.g. /api/cron/expire-listings).
# Required in production; the scheduler sends it as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=""

# Canonical site origin — used for SEO (sitemap.xml, robots.txt, canonical + OG URLs).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Launch market (ASSUMPTION — change to your target city) ---
# Defaulted to Pune, India to match locality examples in the docs.
NEXT_PUBLIC_DEFAULT_CITY="Pune"
NEXT_PUBLIC_DEFAULT_COUNTRY="IN"
NEXT_PUBLIC_DEFAULT_CURRENCY="INR"

# SMS OTP provider (MSG91 for India / Twilio). Leave blank to use dev console stub.
SMS_PROVIDER=""            # "msg91" | "twilio" | "" (dev: logs code to server console)
SMS_API_KEY=""

# Maps (Mapbox recommended)
NEXT_PUBLIC_MAPBOX_TOKEN=""

# Media CDN — origin that fronts the uploads path (CloudFront/Cloudflare in front of /uploads,
# or an object-store public base). When set, stored media resolve to `<base>/uploads/<key>`;
# leave blank in dev to serve origin-relative `/uploads/<key>`. See src/lib/storage.ts.
MEDIA_CDN_BASE_URL=""

# Observability (optional in dev)
SENTRY_DSN=""
NEXT_PUBLIC_POSTHOG_KEY=""
