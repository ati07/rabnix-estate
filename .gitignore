# Dependencies
node_modules/
.pnp/
.pnp.js

# Builds
dist/
build/
.next/
out/
tsconfig.tsbuildinfo

# Uploaded media (dev local storage; production uses an object store / CDN)
/public/uploads/

# Env & secrets
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Test & coverage
coverage/
.nyc_output/

# Claude Code — keep shared settings, ignore local/personal ones
.claude/settings.local.json

# Scratch — throwaway local analysis, third-party page dumps, etc. (never commit)
.scratch/

# Misc
*.local

# Local backups (e.g. globals_old.css, "globals copy.css") — keep on disk, never commit
*_old.*
* copy.*
# Uncompressed source PNGs for hero backgrounds (committed .jpg is used instead)
/public/post-hero-bg.png
